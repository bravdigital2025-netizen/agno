# =============================================================================
# WordPress / Hosting — Brav Digital
# Copie para .env e preencha os valores
# =============================================================================

# URL do site WordPress
WORDPRESS_URL=http://bravdigital.com

# --- Opção 1: Application Password (recomendado) ---
# Gere em: WordPress Admin > Usuários > Perfil > Senhas de Aplicativo
WORDPRESS_USERNAME=seu_usuario_wp
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- Opção 2: API Key / Bearer Token ---
# Use se o seu hosting ou plugin JWT fornecer um token diretamente
WORDPRESS_API_KEY=

# --- Anthropic (para agente de teste) ---
ANTHROPIC_API_KEY=sk-ant-...
