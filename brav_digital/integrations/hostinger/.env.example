# =============================================================================
# Hostinger API — Brav Digital
# =============================================================================
# Gere o token em: hPanel > ícone do perfil > Informações da conta > API > Gerar token
HOSTINGER_API_TOKEN=

# =============================================================================
# WordPress — bravdigital.com (hospedado na Hostinger)
# =============================================================================
WORDPRESS_URL=http://bravdigital.com

# Application Password (recomendado para WordPress na Hostinger)
# Gere em: WordPress Admin > Usuários > Perfil > Senhas de Aplicativo
WORDPRESS_USERNAME=seu_usuario_wp
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# =============================================================================
# Anthropic
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-...
